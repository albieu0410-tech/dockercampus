# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Full database URL for Rust (sqlx)
DATABASE_URL=

# Full database URL for Python (SQLAlchemy)
DATABASE_URL_PYTHON=

# JWT (Python backend)
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

# Rust container engine
RUST_LOG=
CONTAINER_ENGINE_URL=

# Python backend
BACKEND_URL=

# Cloudflare
CLOUDFLARE_TUNNEL_ID=

# Frontend
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=

# Professor account (created on first startup)
PROFESSOR_EMAIL=
PROFESSOR_PASSWORD=

# Environment
ENVIRONMENT=

# Security — Phase 1
# Comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Container behavior — Phase 2
# Minutes of inactivity before container sleeps
IDLE_SLEEP_MINUTES=10
# Maximum simultaneous running containers
MAX_CONTAINERS=8

# Resend (already used, make sure this is set)
RESEND_API_KEY=

# Frontend URL (used for password reset links)
FRONTEND_URL=https://dockcampus.sudelca.com
