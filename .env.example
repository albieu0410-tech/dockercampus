# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Full database URL for Rust (sqlx)
DATABASE_URL_RUST=

SECRET_KEY=
JWT_EXP_MINUTES=480

# Rust container engine
RUST_LOG=
CONTAINER_ENGINE_URL=
# Public base URL used in the OpenAPI docs "servers" field (defaults to https://api.sudelca.com in production)
API_BASE_URL=

# Cloudflare
CLOUDFLARE_TUNNEL_ID=

# Frontend
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=

# Professor account (created on first startup)
PROFESSOR_EMAIL=
PROFESSOR_PASSWORD=

# Environment
ENVIRONMENT=
# Set ENVIRONMENT=development and this to false to bypass OTP locally.
# Production always enforces the OTP step.
AUTH_2FA_ENABLED=true

# Security — Phase 1
# Comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Container behavior — Phase 2
# Minutes of inactivity before container sleeps
IDLE_SLEEP_MINUTES=10
# Sleep manager runtime controls
SLEEP_MANAGER_ENABLED=true
SLEEP_SCAN_SECONDS=60
# Maximum simultaneous running containers
MAX_CONTAINERS=8

# Resend (already used, make sure this is set)
RESEND_API_KEY=

# Frontend URL (used for password reset links)
FRONTEND_URL=https://dockcampus.sudelca.com

# Hive mesh
HIVE_JOIN_TOKEN=
# Public URL used to build node join command
CONTAINER_ENGINE_PUBLIC_URL=

# WireGuard mesh
WIREGUARD_INTERFACE=wg0
WIREGUARD_NETWORK_CIDR=10.10.0.0/24
WIREGUARD_LISTEN_PORT=51820
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
